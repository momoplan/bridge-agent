{
  "build": {
    "beforeBuildCommand": "node scripts/prepare-windows-uninstaller.mjs --with-frontend"
  },
  "bundle": {
    "externalBin": [
      "binaries/bridge-agent-uninstaller"
    ],
    "windows": {
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows-artifact.ps1 %1",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "wix": {
        "upgradeCode": "94895101-CD67-53B8-BB30-F95026802DF2",
        "language": "zh-CN",
        "fragmentPaths": [
          "wix/bridge-agent-windows-runtime.wxs"
        ],
        "componentRefs": [
          "BridgeAgentDataDirectoryComponent",
          "BridgeAgentGuidedUninstallShortcutComponent"
        ]
      },
      "nsis": {
        "installerHooks": "nsis/desktop-shortcut.nsh"
      }
    }
  }
}
